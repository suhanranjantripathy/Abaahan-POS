VITE_APP_NAME=Abahaan
VITE_APP_POS_NAME=Abahaan POS

# Current app supports "local" by default. Set to "api" or "supabase" when a backend is ready.
VITE_DATA_BACKEND=local
VITE_API_BASE_URL=
# Browser-exposed value. Do not put server secrets here; use a short-lived user/session token only.
VITE_API_TOKEN=
VITE_SUPABASE_URL=
# Browser-exposed public anon key. Keep the service role key only in Supabase/backend secrets.
VITE_SUPABASE_ANON_KEY=

# Employee login endpoint. If omitted, the app uses the current Google Apps Script endpoint.
VITE_EMPLOYEE_AUTH_URL=

# Razorpay
VITE_RAZORPAY_SCRIPT_URL=https://checkout.razorpay.com/v1/checkout.js
# Browser-exposed public key only. Never use a Razorpay key secret in Vite env.
VITE_RAZORPAY_KEY=

# Outbound email identity. Browser mailto links cannot force this sender;
# backend SMTP/API sending should use this same value as the from address.
VITE_EMAIL_FROM=testtrailattempt@gmail.com
VITE_GOOGLE_REVIEW_URL=

# Supabase Edge Function / email secrets are set in Supabase, not exposed to Vite:
# EMAIL_PROVIDER=gmail_smtp|resend|postmark
# EMAIL_FROM=testtrailattempt@gmail.com
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=testtrailattempt@gmail.com
# SMTP_PASS=<gmail-app-password>
# RESEND_API_KEY=
# POSTMARK_SERVER_TOKEN=
# PORTAL_TOKEN_SECRET=<long-random-secret>
